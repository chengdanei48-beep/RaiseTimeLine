# このファイルを .env にコピーして値を設定する(.env は git 管理外)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=raisetimeline
DB_USER=raisetimeline
DB_PASSWORD=change-me

# JWT の署名鍵(32 バイト以上のランダムな文字列)
JWT_SECRET=change-me-to-a-random-string-of-32-bytes-or-more

# 画像用 S3(開発は docker-compose の s3。署名付き URL はブラウザから直接使うため localhost で到達できること)
S3_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=raisetimeline-images
AWS_REGION=ap-northeast-1
# 開発用サーバーは認証を見ないので、値は何でもよい(AWS では空にして IAM ロールを使う)
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key

# API 仕様書(OpenAPI)と Swagger UI を公開する(開発用。本番では設定しない)
# http://localhost:8080/swagger-ui.html  /  http://localhost:8080/v3/api-docs
API_DOCS_ENABLED=true
