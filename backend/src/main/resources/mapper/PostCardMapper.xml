<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  投稿カードに載せる付随情報を、投稿ID群に対して 1 クエリずつ一括で取得する(N+1 を避ける)。
  いいねとコメントは JOIN すると行が掛け算で膨らむため、別クエリで集計する。
-->
<mapper namespace="com.raisetimeline.repository.PostCardMapper">

  <select id="countLikes" resultType="com.raisetimeline.entity.PostCount">
    SELECT post_id, COUNT(*) AS total
    FROM likes
    WHERE post_id IN
      <foreach collection="postIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    GROUP BY post_id
  </select>

  <select id="countComments" resultType="com.raisetimeline.entity.PostCount">
    SELECT post_id, COUNT(*) AS total
    FROM comments
    WHERE deleted_at IS NULL AND post_id IN
      <foreach collection="postIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    GROUP BY post_id
  </select>

  <select id="findLikedPostIds" resultType="long">
    SELECT post_id
    FROM likes
    WHERE user_id = #{userId} AND post_id IN
      <foreach collection="postIds" item="id" open="(" separator="," close=")">#{id}</foreach>
  </select>

  <!-- 画像は投稿 ID 群に対して 1 クエリで取得する。表示順(sort_order)の昇順。 -->
  <select id="findImagesByPostIds" resultType="com.raisetimeline.entity.PostImage">
    SELECT post_id, object_key, sort_order
    FROM post_images
    WHERE post_id IN
      <foreach collection="postIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    ORDER BY post_id, sort_order
  </select>

</mapper>
