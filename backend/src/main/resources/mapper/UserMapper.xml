<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.raisetimeline.repository.UserMapper">

  <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    INSERT INTO users (username, password_hash, display_name)
    VALUES (#{username}, #{passwordHash}, #{displayName})
  </insert>

  <select id="findByUsername" resultType="com.raisetimeline.entity.User">
    SELECT * FROM users WHERE lower(username) = lower(#{username})
  </select>

  <select id="findById" resultType="com.raisetimeline.entity.User">
    SELECT * FROM users WHERE id = #{id}
  </select>

</mapper>
