<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- DI でコンストラクタ注入した Bean(Mapper・Service など)を保持するだけなので誤検知 -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <Class name="~com\.raisetimeline\.(service|controller|security)\..*"/>
    </Or>
  </Match>
  <!-- コンストラクタで List.copyOf した不変リストを保持するだけなので誤検知 -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Class name="com.raisetimeline.dto.TimelineResponse"/>
  </Match>
</FindBugsFilter>
